# Database connection string (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/korbit_abos?schema=public"

# NextAuth / Auth Secret
AUTH_SECRET="korbit_abos_mvp_auth_secret_placeholder_key_change_in_production"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Razorpay Credentials (MVP Billing & Subscriptions)
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="rzp_test_secret_placeholder"

# Google Gemini API Key (Voice-to-CRM structured extraction & analysis)
GEMINI_API_KEY="your_gemini_api_key_placeholder"

# Google Maps API Key (Field Attendance, 3-Point GPS check-ins & radius validation)
GOOGLE_MAPS_API_KEY="your_google_maps_api_key_placeholder"

# Cron Secret (Vercel & Coolify SLA Auto-Escalation cron protection)
CRON_SECRET="your_production_cron_secret_key_here"

# Transactional Email SMTP (Nodemailer - Stage 4 Proposals & Welcome Emails)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="notifications@korbit.in"
SMTP_PASS="your_smtp_app_password"
SMTP_FROM="KORBIT ABOS <notifications@korbit.in>"
